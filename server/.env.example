# ==============================================================
# CyberHero Server Environment Configuration (Template)
# Dhaanish Ahmed College of Engineering, Chennai
# ==============================================================

PORT=5000
NODE_ENV=development

# Database connection URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5433/cyberhero?schema=public"

# Auth Secrets (32+ chars random string in production)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_min_32_chars"
SESSION_SECRET="replace_with_a_secure_session_secret_min_32_chars"

# Frontend Application URL for CORS allowlisting
APP_URL="http://localhost:5173"

# Bootstrap Faculty Account (Required for initial login)
FACULTY_EMAIL="dhaanishchennai@gmail.com"
FACULTY_PASSWORD="replace_with_initial_faculty_password"

# Email Delivery Configuration (Configurable for SMTP / Resend / SendGrid)
# If left blank, OTPs will be securely recorded in verification logs for development
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="CyberHero Dhaanish <noreply@dhaanishchennai.edu.in>"

# SMS Delivery Configuration (Optional - only enabled when configured)
SMS_PROVIDER=""
SMS_API_KEY=""
